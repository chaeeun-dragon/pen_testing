# 합성 실습용 값만 사용한다. 실제 비밀번호·카드번호·금융망 자격증명을 넣지 않는다.
COMPOSE_PROJECT_NAME=bookwave-haeon-lab
LAB_PROFILE=normal
SPRING_PROFILES_ACTIVE=lab
ERROR_INJECTION_ENABLED=false
COVER_UPLOAD_RUNTIME=java-spring
HAEON_MERCHANT_NO=BOOKWAVE-LAB
HAEON_MERCHANT_TOKEN=lab-merchant-bookwave
HAEON_CARD_INSTANCE_ID=haeon-card-1
BEFORE_BARRIER_ENABLED=false
BARRIER_TIMEOUT_SECONDS=5

BOOKWAVE_APP_PORT=8080
MOCK_PG_PORT=8083
HAEON_CARD_PORT=8084

BOOKWAVE_DB_NAME=bookwave
BOOKWAVE_DB_USER=bookwave_app
BOOKWAVE_DB_PASSWORD=bookwave_app_lab_only
BOOKWAVE_DB_ROOT_PASSWORD=root_bookwave_lab_only

HAEON_DB_NAME=haeon_card
HAEON_DB_USER=haeon_app
HAEON_DB_PASSWORD=haeon_app_lab_only
HAEON_DB_ROOT_PASSWORD=root_lab_only
